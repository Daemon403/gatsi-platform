{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "APP_ENV": "development" } },
    "preview": { "distribution": "internal", "channel": "preview", "env": { "APP_ENV": "preview", "EXPO_PUBLIC_API_URL": "https://gatsi-platform-web.vercel.app" } },
    "staging": { "distribution": "internal", "channel": "staging", "env": { "APP_ENV": "staging", "EXPO_PUBLIC_API_URL": "https://gatsi-platform-web.vercel.app" } },
    "production": { "autoIncrement": true, "channel": "production", "env": { "APP_ENV": "production", "EXPO_PUBLIC_API_URL": "https://gatsi-platform-web.vercel.app" } }
  },
  "submit": { "production": {} }
}
