NODE_ENV=development
APP_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatsi
# Use a direct, non-pooler connection for deployment migrations when available.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/gatsi
DATABASE_SSL=false
DB_POOL_SIZE=10
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
TOKEN_PEPPER_CURRENT=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-a-strong-random-secret
INITIAL_ADMIN_USERNAME=Promise
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-random-password
INITIAL_ADMIN_NAME=Promise Gatsi
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PHONE=
# TOKEN_PEPPER_PREVIOUS=previous-value-during-rotation
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
IDEMPOTENCY_RETENTION_DAYS=365
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET_CURRENT=replace-with-a-random-secret
ERROR_WEBHOOK_URL=
